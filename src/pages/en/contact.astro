---
import Layout from '../../layouts/Layout.astro';
// Fixed a live bug while porting: the legacy page linked a fake placeholder
// WhatsApp number (wa.me/15551234567 -- a 555 number, never real). The real
// number (+1-226-503-0456) appears elsewhere on the live site
// (assets/downloads/ceo_us_university_informe_final.html) -- used below.
---

<Layout
  lang="en"
  path="/en/contact.html"
  alternatePath="/es/contacto.html"
  title="Contact | Ubik 360 — Digital Marketing & International Expansion"
  description="Get in touch with José Villegas about digital marketing or international business expansion. We meet on Google Meet, at a coffee shop, or I come to you. No fixed office, no gatekeepers."
>
  <!-- HERO -->
  <section style="background:#fff; padding:6rem 0 4rem;">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <span class="section-tag mb-4" style="display:block;">Contact</span>
      <h1 style="font-size:clamp(2.25rem,5vw,3.25rem); line-height:1.15; color:var(--black); margin:0 0 1.25rem;">
        Let's talk about<br />your business
      </h1>
      <p style="font-size:1.125rem; color:#4b5563; line-height:1.75; max-width:36rem; margin:0 auto;">
        No fixed office—I work around you. We can connect on Google Meet, grab a coffee nearby, or I'll come to your office and see your operation firsthand. Whatever works best.
      </p>
    </div>
  </section>

  <!-- THREE WAYS TO CONNECT -->
  <section style="background:var(--oak); padding:4rem 0;">
    <div class="max-w-5xl mx-auto px-6">
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:1.5rem;">
        <div style="background:#fff; border-radius:.75rem; padding:2rem; text-align:center;">
          <h3 style="font-size:1.125rem; margin:0 0 .5rem; color:var(--black);">Book a time</h3>
          <p style="font-size:.875rem; color:#6b7280; line-height:1.65; margin:0 0 1.5rem;">Pick a time that works for you. 30 minutes, free, no obligation.</p>
          <a href="https://calendly.com/jose-ubik360/30min" target="_blank" rel="noopener" class="btn-primary" style="width:100%; display:block; font-size:.875rem;">Check availability</a>
        </div>
        <div style="background:#fff; border-radius:.75rem; padding:2rem; text-align:center;">
          <h3 style="font-size:1.125rem; margin:0 0 .5rem; color:var(--black);">Google Meet</h3>
          <p style="font-size:.875rem; color:#6b7280; line-height:1.65; margin:0 0 1.5rem;">Perfect if you're in another city or country. Same conversation, zero travel.</p>
          <a href="https://calendly.com/jose-ubik360/30min" target="_blank" rel="noopener" class="btn-outline" style="width:100%; display:block; font-size:.875rem;">Schedule a video call</a>
        </div>
        <div style="background:#fff; border-radius:.75rem; padding:2rem; text-align:center;">
          <h3 style="font-size:1.125rem; margin:0 0 .5rem; color:var(--black);">In person</h3>
          <p style="font-size:.875rem; color:#6b7280; line-height:1.65; margin:0 0 1.5rem;">I'll come to your office or we meet at a coffee shop. I prefer seeing your business in its own environment.</p>
          <a href="#form" class="btn-outline" style="width:100%; display:block; font-size:.875rem;">Tell me more</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section id="form" style="background:#fff; padding:5rem 0;">
    <div class="max-w-2xl mx-auto px-6">
      <div class="text-center" style="margin-bottom:3rem;">
        <span class="section-tag mb-3" style="display:block;">Send a Message</span>
        <h2 style="font-size:clamp(1.75rem,4vw,2.5rem); color:var(--black); margin:0 0 1rem;">Tell me what's going on</h2>
        <p style="font-size:1rem; color:#6b7280; line-height:1.7; max-width:30rem; margin:0 auto;">I respond within 24 hours. If you'd rather just talk, use the calendar above.</p>
      </div>

      <form id="contact-form" action="https://formspree.io/f/mlganpda" method="POST" novalidate>
        <input type="hidden" name="pagina_origen" value="en/contact.html" />

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; margin-bottom:1.25rem;">
          <div>
            <label class="text-sm font-medium block mb-1.5" style="color:var(--black);" for="name">Name *</label>
            <input class="w-full px-4 py-2.5 border border-gray-300 rounded-md text-[.9375rem]" type="text" id="name" name="name" required placeholder="Your name" />
          </div>
          <div>
            <label class="text-sm font-medium block mb-1.5" style="color:var(--black);" for="company">Company</label>
            <input class="w-full px-4 py-2.5 border border-gray-300 rounded-md text-[.9375rem]" type="text" id="company" name="company" placeholder="Your company" />
          </div>
        </div>

        <div style="margin-bottom:1.25rem;">
          <label class="text-sm font-medium block mb-1.5" style="color:var(--black);" for="email">Email address *</label>
          <input class="w-full px-4 py-2.5 border border-gray-300 rounded-md text-[.9375rem]" type="email" id="email" name="email" required placeholder="you@yourcompany.com" />
        </div>

        <div style="margin-bottom:1.25rem;">
          <span class="text-sm font-medium block mb-2.5" style="color:var(--black);">How should I reach you?</span>
          <div style="display:flex; gap:1.5rem;">
            <label style="display:flex; align-items:center; gap:.5rem; cursor:pointer; font-size:.9375rem;">
              <input type="radio" name="contact_preference" value="Email" checked style="accent-color:var(--green); width:1rem; height:1rem;" id="pref-email" />
              Email
            </label>
            <label style="display:flex; align-items:center; gap:.5rem; cursor:pointer; font-size:.9375rem;">
              <input type="radio" name="contact_preference" value="Phone / WhatsApp" style="accent-color:var(--green); width:1rem; height:1rem;" id="pref-phone" />
              Phone / WhatsApp
            </label>
          </div>
        </div>

        <div id="phone-group" style="display:none; margin-bottom:1.25rem;">
          <label class="text-sm font-medium block mb-1.5" style="color:var(--black);" for="phone">Phone / WhatsApp</label>
          <input class="w-full px-4 py-2.5 border border-gray-300 rounded-md text-[.9375rem]" type="tel" id="phone" name="phone" placeholder="+1 (555) 000-0000" />
        </div>

        <div style="margin-bottom:1.25rem;">
          <label class="text-sm font-medium block mb-1.5" style="color:var(--black);" for="service">What can I help you with? *</label>
          <select class="w-full px-4 py-2.5 border border-gray-300 rounded-md text-[.9375rem]" id="service" name="service" required>
            <option value="" disabled selected>Select an option</option>
            <option value="Digital Marketing">Digital Marketing</option>
            <option value="Nearshore Staffing">Nearshore Staffing / Sourcing</option>
            <option value="International Expansion">Expand Into Colombia</option>
            <option value="Other">Other / Not sure yet</option>
          </select>
        </div>

        <div style="margin-bottom:1.25rem;">
          <label class="text-sm font-medium block mb-1.5" style="color:var(--black);" for="country">Where are you based?</label>
          <select class="w-full px-4 py-2.5 border border-gray-300 rounded-md text-[.9375rem]" id="country" name="country">
            <option value="" disabled selected>Select your country</option>
            <option value="United States">United States</option>
            <option value="Canada">Canada</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div style="margin-bottom:2rem;">
          <label class="text-sm font-medium block mb-1.5" style="color:var(--black);" for="message">Tell me about your business and what you need *</label>
          <textarea class="w-full px-4 py-2.5 border border-gray-300 rounded-md text-[.9375rem]" style="resize:vertical; min-height:9rem;" id="message" name="message" required placeholder="What's happening in your business? What outcome are you looking for? The more context you share, the better prepared I'll be for our conversation."></textarea>
        </div>

        <button type="submit" class="btn-primary" style="width:100%; font-size:1rem; padding:1rem;">Send Message</button>
        <p style="margin-top:1rem; font-size:.8125rem; color:#9ca3af; text-align:center;">Your information stays private. I don't share data with third parties.</p>
      </form>
    </div>
  </section>

  <!-- DIRECT CONTACT STRIP -->
  <section style="background:var(--black); padding:4rem 0;">
    <div class="max-w-4xl mx-auto px-6">
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:2rem; text-align:center;">
        <div>
          <p style="font-size:.75rem; color:#9ca3af; text-transform:uppercase; letter-spacing:.1em; margin:0 0 .375rem;">Email</p>
          <a href="mailto:jose@ubik360.com" style="color:#fff; font-size:.9375rem; font-weight:500;">jose@ubik360.com</a>
        </div>
        <div>
          <p style="font-size:.75rem; color:#9ca3af; text-transform:uppercase; letter-spacing:.1em; margin:0 0 .375rem;">WhatsApp</p>
          <a href="https://wa.me/12265030456" target="_blank" rel="noopener" style="color:#fff; font-size:.9375rem; font-weight:500;">Send a message</a>
        </div>
        <div>
          <p style="font-size:.75rem; color:#9ca3af; text-transform:uppercase; letter-spacing:.1em; margin:0 0 .375rem;">LinkedIn</p>
          <a href="https://www.linkedin.com/in/jose-villegas-marketing-manager/" target="_blank" rel="noopener" style="color:#fff; font-size:.9375rem; font-weight:500;">Connect</a>
        </div>
        <div>
          <p style="font-size:.75rem; color:#9ca3af; text-transform:uppercase; letter-spacing:.1em; margin:0 0 .375rem;">Response time</p>
          <p style="color:#fff; font-size:.9375rem; font-weight:500; margin:0;">Within 24 hours</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const emailRadio = document.getElementById('pref-email');
    const phoneRadio = document.getElementById('pref-phone');
    const phoneGroup = document.getElementById('phone-group');
    emailRadio?.addEventListener('change', () => { if (phoneGroup) phoneGroup.style.display = 'none'; });
    phoneRadio?.addEventListener('change', () => { if (phoneGroup) phoneGroup.style.display = 'block'; });

    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Sending…';
      fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
        .then((res) => {
          if (res.ok) {
            window.location.href = '/en/thank-you.html';
          } else {
            btn.disabled = false;
            btn.textContent = 'Send Message';
            alert('Something went wrong. Please try again.');
          }
        })
        .catch(() => {
          btn.disabled = false;
          btn.textContent = 'Send Message';
          alert('Connection error. Check your internet and try again.');
        });
    });
  </script>
</Layout>
