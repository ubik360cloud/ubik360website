# Newsletter/contact (existing -- see CLAUDE.md "Newsletter (SendGrid)").
# List ids are the actual list UUIDs from SendGrid's Marketing > Contacts >
# Lists UI -- no sensible hardcoded default, the lists must exist first.
SENDGRID_API_KEY=
SENDGRID_LIST_NEWSLETTER=
SENDGRID_LIST_CONTACT=

# Growth Hub (Apollo outreach) -- see docs/growth-hub-status.md
# New Supabase project, separate from any other project on the account.
GROWTH_SUPABASE_URL=
GROWTH_SUPABASE_ANON_KEY=
GROWTH_SUPABASE_SERVICE_ROLE_KEY=

# The one allowlisted user for the hub (Jose's own Supabase Auth email --
# can be any address he can receive a magic link at, doesn't have to match
# jose@ubik360.com).
GROWTH_OWNER_EMAIL=

# Apollo.io -- reused from the existing Apollo subscription (Jose confirmed
# 2026-09 this is fine to reuse, unlike the other 360PrintStudio keys).
APOLLO_API_KEY=

# Text generation (filter suggestions, flow drafts, 1:1 research) -- see
# _lib/llm.js. Switched from DeepInfra/DeepSeek-V3 to OpenAI gpt-4o-mini
# 2026-09-28 (Jose: DeepSeek-V3's email copy quality was poor). LLM_PROVIDER
# picks openai|deepinfra; LLM_MODEL overrides that provider's default model.
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# DeepInfra -- still used for image/video generation (see CLAUDE.md's
# DeepInfra convention note) even after switching text generation to OpenAI
# above. Env var name matches what Jose actually named it in Vercel (not a
# generic DEEPINFRA_API_KEY).
DEEPINFRA_UBIK30_KEY=
IMAGES_MODEL=black-forest-labs/FLUX-2-klein-4b
VIDEOS_MODEL=Pixverse/Pixverse-6-T2V
# Vercel Cron auth (Vercel sets `Authorization: Bearer <CRON_SECRET>`
# automatically on cron-triggered requests once this is set in the project).
CRON_SECRET=

# SendGrid Event Webhook auth (Settings -> Mail Settings -> Event Webhook in
# SendGrid's dashboard, pointed at /api/growth/webhooks/sendgrid?secret=<this value>).
GROWTH_WEBHOOK_SECRET=

# Alternate bearer credential for owner-authed routes, same trust level as a
# Supabase owner session -- lets a one-off admin action (e.g. a Claude Code
# session creating a test Apollo pull) call the API directly without going
# through the hub UI's browser login. Optional; leave unset to require a
# real Supabase session on every owner route.
GROWTH_ADMIN_SECRET=

# CORS allowlist for the hub app calling this API cross-origin.
GROWTH_HUB_ORIGIN=https://marketing.ubik360.com

# Combined daily send cap across both tracks (default 10 if unset).
GROWTH_DAILY_SEND_CAP=10
