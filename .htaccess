# ============================================================
# Ubik 360 — Cache & Performance Rules (Apache / Hostinger)
# ============================================================

# Enable compression (faster page loads)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Caching rules by file type ───────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — never cache, always fetch fresh
  ExpiresByType text/html                 "access plus 0 seconds"

  # CSS & JS — cache 1 week; version string in filename busts cache on update
  ExpiresByType text/css                  "access plus 1 week"
  ExpiresByType application/javascript    "access plus 1 week"
  ExpiresByType text/javascript           "access plus 1 week"

  # Images — cache 1 month (they rarely change)
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 month"

  # Fonts — cache 1 year (never change once deployed)
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
</IfModule>

# ── Force no-cache on HTML via headers ───────────────────────
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# ═══════════════════════════════════════════════════════════
# 301 PERMANENT REDIRECTS
# ═══════════════════════════════════════════════════════════
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── Old brand / service pages (previous website) ──────────
  RewriteRule ^About-Ubik-360-Cloud-Services/?$          / [R=301,L]
  RewriteRule ^E-commerce-Solutions/?$                   / [R=301,L]
  RewriteRule ^Ubik-360-Startups-Services/?$             / [R=301,L]
  RewriteRule ^Construction-Digital-Solutions/?$         / [R=301,L]
  RewriteRule ^Cloud-Migration-Services/?$               / [R=301,L]
  RewriteRule ^Infrastructure-as-a-Service/?$            / [R=301,L]
  RewriteRule ^Business-Analytics-Services/?$            / [R=301,L]
  RewriteRule ^pymes-it-soluciones/?$                    / [R=301,L]
  RewriteRule ^AI-Digital-Marketing-Services/?$          / [R=301,L]
  RewriteRule ^Cloud-Technology-School/?$                / [R=301,L]
  RewriteRule ^Privacy-Policy/?$                         / [R=301,L]
  RewriteRule ^why-professional-websites-matter\.html$   / [R=301,L]
  RewriteRule ^Platform-as-a-Service/?$                  / [R=301,L]
  RewriteRule ^sistemas-estaciones-de-servicio/?$        / [R=301,L]
  RewriteRule ^Terms-of-Service/?$                       / [R=301,L]

  # ── Old Spanish pages (root-level, no /es/ prefix) ────────
  RewriteRule ^marketing-digital\.html$       /es/marketing-digital.html       [R=301,L]
  RewriteRule ^expansion-internacional\.html$ /es/expansion-internacional.html [R=301,L]
  RewriteRule ^sobre-mi\.html$                /es/sobre-mi.html                [R=301,L]
  RewriteRule ^contacto\.html$                /es/contacto.html                [R=301,L]
  RewriteRule ^servicios\.html$               /es/index.html                   [R=301,L]

  # ── Old English pages (root-level, no /en/ prefix) ────────
  RewriteRule ^digital-marketing\.html$       /en/digital-marketing.html       [R=301,L]
  RewriteRule ^about\.html$                   /en/about.html                   [R=301,L]
  RewriteRule ^contact\.html$                 /en/contact.html                 [R=301,L]
  RewriteRule ^services\.html$                /en/index.html                   [R=301,L]

  # ── Old v1 subdirectory structure ─────────────────────────
  RewriteRule ^en/services/digital-marketing\.html$        /en/digital-marketing.html       [R=301,L]
  RewriteRule ^en/services/international-expansion\.html$  /en/international-expansion.html [R=301,L]
  RewriteRule ^es/servicios/marketing-digital\.html$       /es/marketing-digital.html       [R=301,L]
  RewriteRule ^es/servicios/expansion-internacional\.html$ /es/expansion-internacional.html [R=301,L]
</IfModule>

# ── Language redirect fallback (if JS is disabled) ───────────
# Uncomment below only if you want server-side language redirect
# instead of the JS-based root index.html.
# This reads the browser's Accept-Language header.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteRule ^$ - [L]
#   RewriteCond %{HTTP:Accept-Language} ^es [NC]
#   RewriteRule ^$ /es/ [R=302,L]
#   RewriteRule ^$ /en/ [R=302,L]
# </IfModule>
