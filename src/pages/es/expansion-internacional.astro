---
import Layout from '../../layouts/Layout.astro';
// Main/only ES service page per MARKETING.md. Keeps only the Colombia->US/CA
// direction (drops US/CA->Colombia + nearshoring -- those are en/international-
// expansion.html and en/nearshore-staffing.html's jobs). Absorbs the old
// marketing-digital.html content, reframed as "marketing in your new market"
// (not a standalone digital-marketing service), plus NEW: event/trade-show
// planning and explicit local-operations-efficiency scope. ICP: mid-sized+
// businesses ready to invest -- see MARKETING.md Audience/ICP note; copy
// self-selects for readiness rather than overselling ease.
// Reuses the existing "Checklist de Incorporación" lead magnet asset.

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Qué estados de EE.UU. son mejores para incorporar una empresa colombiana?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Depende del modelo de negocio. Delaware es ideal para empresas que buscan inversión o tienen socios múltiples. Florida es preferida para operaciones físicas o clientes en el sureste. Wyoming ofrece privacidad y bajos costos, ideal para negocios 100% en línea. En la consulta inicial evaluamos cuál se adapta mejor a tu caso.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Qué incluye el acompañamiento de marketing en el nuevo mercado?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Estrategia de mensajes y posicionamiento construida para el mercado de destino (no traducida desde el mercado de origen), selección de canales, y participación en ferias y eventos comerciales relevantes para tu industria.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Qué tan preparada debe estar mi empresa antes de expandirse?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'La expansión funciona cuando el negocio ya tiene la base para sostenerla: capacidad de inversión, disposición a operar con personal bilingüe, y procesos mínimamente estructurados para exportación y atención al cliente internacional. La consulta inicial evalúa honestamente si es el momento adecuado.',
      },
    },
  ],
};
---

<Layout
  lang="es"
  path="/es/expansion-internacional.html"
  title="Expansión Internacional | Colombia a EE.UU. y Canadá | Ubik 360"
  description="Incorporación, agente registrado, marketing en tu nuevo mercado y ferias comerciales — para empresas colombianas y latinoamericanas listas para expandirse a EE.UU. y Canadá."
  structuredData={faqSchema}
>
  <!-- HERO -->
  <section style="background:#fff; padding:5rem 0 4rem;">
    <div class="max-w-3xl mx-auto px-6">
      <span class="section-tag mb-4">Expansión Internacional</span>
      <h1 class="text-4xl lg:text-5xl leading-tight mb-5" style="color:var(--black);">
        Expandirse a EE.UU. o Canadá no es un trámite. Es un proceso.
      </h1>
      <p class="text-xl leading-relaxed mb-8" style="color:#4b5563;">
        Incorporación, agente registrado y banca son el punto de partida — el trabajo real está en
        el mercado, la operación y el marketing una vez que estás dentro. Ubik 360 acompaña el
        camino completo, para empresas listas para invertir en su crecimiento internacional.
      </p>
      <a href="https://calendly.com/jose-ubik360/30min" target="_blank" rel="noopener" class="btn-primary">Agenda tu Consulta de Expansión</a>
    </div>
  </section>

  <!-- ENTITY FORMATION -->
  <section style="background:#fff; padding:5rem 0;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-10">
        <span class="section-tag mb-3">Incorporación y Presencia Legal</span>
        <h2 class="text-3xl lg:text-4xl mb-4" style="color:var(--black);">Lo que incluye el servicio</h2>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="service-card">
          <h3 class="text-xl mb-2" style="color:var(--black);">Incorporación de Empresa</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.7;">LLC o Corporación en Florida, Delaware o Wyoming (EE.UU.) o en Ontario (Canadá). Incluye EIN, artículos de organización y operating agreement.</p>
        </div>
        <div id="agente-registrado" class="service-card">
          <h3 class="text-xl mb-2" style="color:var(--black);">Agente Registrado</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.7;">Actuamos como tu Registered Agent en Florida y Delaware — recibimos y gestionamos toda correspondencia legal y notificaciones del estado.</p>
        </div>
        <div class="service-card">
          <h3 class="text-xl mb-2" style="color:var(--black);">Dirección Virtual y Teléfono Local</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.7;">Dirección comercial real con recepción de correspondencia y número local en Miami, Orlando, Houston, Nueva York, Los Ángeles o Toronto.</p>
        </div>
        <div class="service-card">
          <h3 class="text-xl mb-2" style="color:var(--black);">Cuenta Bancaria Empresarial</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.7;">Acompañamiento en la apertura de cuenta bancaria en EE.UU. o Canadá, incluyendo bancos que trabajan con no residentes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MARKETING EN TU NUEVO MERCADO -->
  <section id="marketing-en-tu-nuevo-mercado" style="background:var(--oak); padding:5rem 0;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-10">
        <span class="section-tag mb-3" style="color:var(--red);">Una Vez Adentro</span>
        <h2 class="text-3xl lg:text-4xl mb-4" style="color:var(--black);">Marketing en tu Nuevo Mercado</h2>
        <p class="text-lg leading-relaxed" style="color:#3d3d3d;">
          Estar incorporado no es estar operando. La estrategia de marketing para el mercado de
          destino se construye para ese mercado desde el inicio — no se traduce después de
          escribirla para Colombia.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div style="background:#fff; border-radius:.875rem; padding:1.75rem;">
          <h3 class="text-lg mb-2" style="color:var(--black);">Posicionamiento y Mensajes</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.65;">Estrategia de mensajes construida para el comprador del mercado de destino, no adaptada desde el mercado de origen.</p>
        </div>
        <div style="background:#fff; border-radius:.875rem; padding:1.75rem;">
          <h3 class="text-lg mb-2" style="color:var(--black);">Selección de Canales</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.65;">Los canales correctos para llegar a compradores B2B o B2C en EE.UU. o Canadá, según tu industria.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FERIAS Y EVENTOS -->
  <section style="background:#fff; padding:5rem 0;">
    <div class="max-w-4xl mx-auto px-6">
      <span class="section-tag mb-3">También Incluido</span>
      <h2 class="text-3xl lg:text-4xl mb-6" style="color:var(--black);">Ferias Comerciales y Eventos</h2>
      <p style="font-size:1.0625rem; color:#4b5563; line-height:1.85;">
        La presencia en ferias y eventos comerciales relevantes para tu industria acelera la
        confianza en un mercado nuevo. Ubik 360 identifica los eventos correctos, coordina la
        logística, y asegura que la primera impresión de tu empresa en el nuevo mercado sea sólida.
      </p>
    </div>
  </section>

  <!-- CONCERNS -->
  <section style="background:var(--oak); padding:5rem 0;">
    <div class="max-w-4xl mx-auto px-6">
      <span class="section-tag mb-3" style="color:var(--red);">Dudas Comunes</span>
      <h2 class="text-3xl lg:text-4xl mb-8" style="color:var(--black);">Preguntas que vale la pena resolver antes.</h2>
      <div style="display:flex; flex-direction:column; gap:.875rem;">
        <div style="border-left:3px solid var(--red); padding:.875rem 1.125rem; background:rgba(147,31,29,.06); border-radius:0 .5rem .5rem 0;">
          <strong style="color:var(--black); display:block; margin-bottom:.2rem; font-size:.875rem;">¿Y los impuestos en EE.UU.?</strong>
          <p style="margin:0; font-size:.875rem; color:#4b5563; line-height:1.6;">Asesores fiscales certificados en Florida y Delaware aseguran el cumplimiento de todas las obligaciones desde el primer día.</p>
        </div>
        <div style="border-left:3px solid var(--red); padding:.875rem 1.125rem; background:rgba(147,31,29,.06); border-radius:0 .5rem .5rem 0;">
          <strong style="color:var(--black); display:block; margin-bottom:.2rem; font-size:.875rem;">¿Cómo consigo clientes o distribuidores allá?</strong>
          <p style="margin:0; font-size:.875rem; color:#4b5563; line-height:1.6;">Acompañamiento en desarrollo de negocio: ferias comerciales, contacto con distribuidores, y logística local.</p>
        </div>
        <div style="border-left:3px solid var(--red); padding:.875rem 1.125rem; background:rgba(147,31,29,.06); border-radius:0 .5rem .5rem 0;">
          <strong style="color:var(--black); display:block; margin-bottom:.2rem; font-size:.875rem;">¿Puedo operar sin vivir allá?</strong>
          <p style="margin:0; font-size:.875rem; color:#4b5563; line-height:1.6;">Sí. Con agente registrado, dirección virtual y personal administrativo, tu empresa opera profesionalmente sin que debas mudarte.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LEAD MAGNET + FORM -->
  <section id="consulta" style="background:#fff; padding:5rem 0;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-start">
        <div>
          <span class="section-tag mb-3" style="color:var(--red);">Recurso Gratuito</span>
          <h2 class="text-3xl lg:text-4xl mb-4" style="color:var(--black);">
            Descarga Gratis: <em style="font-style:italic; color:var(--red);">Checklist de Incorporación 2026</em>
          </h2>
          <p style="color:#3d3d3d; font-size:1rem; line-height:1.75; margin-bottom:1.5rem;">
            Todo lo que necesitas para incorporar tu LLC en EE.UU. desde Colombia: estado,
            documentos, EIN, agente registrado — y los errores más comunes que bloquean las
            cuentas bancarias.
          </p>
        </div>
        <div style="background:#fff; border:1px solid #e5e7eb; border-radius:1rem; padding:2.25rem; box-shadow:0 4px 24px rgba(0,0,0,.06);">
          <h3 style="font-family:'DM Serif Display',serif; font-size:1.375rem; color:var(--black); margin:0 0 .5rem;">Recibe el checklist gratis</h3>
          <p style="font-size:.875rem; color:#6b7280; margin:0 0 1.75rem;">Te contactaremos para revisar qué aplica específicamente a tu negocio.</p>
          <form id="expansion-form" action="https://formspree.io/f/mlganpda" method="POST" novalidate>
            <input type="hidden" name="_subject" value="Nuevo lead — Checklist Incorporación EE.UU." />
            <input type="hidden" name="pagina_origen" value="es/expansion-internacional.html" />
            <input type="hidden" name="_next" value="https://ubik360.com/es/gracias.html" />
            <div style="margin-bottom:1.125rem;">
              <label for="nombre" class="text-sm font-medium block mb-1.5" style="color:var(--black);">Nombre completo <span style="color:var(--red);">*</span></label>
              <input type="text" id="nombre" name="nombre" class="w-full px-4 py-2.5 border border-gray-300 rounded-md text-[.9375rem]" required autocomplete="name" />
            </div>
            <div style="margin-bottom:1.125rem;">
              <label for="email" class="text-sm font-medium block mb-1.5" style="color:var(--black);">Correo electrónico <span style="color:var(--red);">*</span></label>
              <input type="email" id="email" name="email" class="w-full px-4 py-2.5 border border-gray-300 rounded-md text-[.9375rem]" required autocomplete="email" />
            </div>
            <button type="submit" class="btn-primary" style="width:100%; padding:.875rem; font-size:1rem;">Descargar Checklist Gratis</button>
            <p style="font-size:.75rem; color:#9ca3af; margin:.875rem 0 0; text-align:center;">Sin compromiso. Respondemos en menos de 24 horas.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="background:#f9fafb; padding:5rem 0;">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-12">
        <span class="section-tag mb-3">Preguntas Frecuentes</span>
        <h2 class="text-3xl lg:text-4xl" style="color:var(--black);">Lo que más preguntan</h2>
      </div>
      <div id="faq-list">
        <div class="faq-item">
          <button class="faq-question">
            ¿Qué estados de EE.UU. son mejores para incorporar una empresa colombiana?
            <svg class="faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="faq-answer">Depende del modelo de negocio. Delaware es ideal para empresas que buscan inversión o tienen socios múltiples. Florida es preferida para operaciones físicas o clientes en el sureste. Wyoming ofrece privacidad y bajos costos, ideal para negocios 100% en línea.</div>
        </div>
        <div class="faq-item">
          <button class="faq-question">
            ¿Qué incluye el acompañamiento de marketing en el nuevo mercado?
            <svg class="faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="faq-answer">Estrategia de mensajes y posicionamiento construida para el mercado de destino, selección de canales, y participación en ferias y eventos comerciales relevantes para tu industria.</div>
        </div>
        <div class="faq-item">
          <button class="faq-question">
            ¿Qué tan preparada debe estar mi empresa antes de expandirse?
            <svg class="faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="faq-answer">La expansión funciona cuando el negocio ya tiene la base para sostenerla: capacidad de inversión, disposición a operar con personal bilingüe, y procesos mínimamente estructurados para exportación y atención al cliente internacional. La consulta inicial evalúa honestamente si es el momento adecuado.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section style="background:var(--black); padding:5rem 0;">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <span class="section-tag mb-4" style="color:var(--oak);">Da el Primer Paso</span>
      <h2 class="text-3xl lg:text-4xl mb-5" style="color:#fff;">¿Tu empresa está lista para expandirse?</h2>
      <p style="color:#9ca3af; font-size:1.125rem; line-height:1.7; max-width:30rem; margin:0 auto 2.5rem;">
        Una llamada de 30 minutos. Sin costo, sin compromiso — una idea clara de qué hacer y qué esperar.
      </p>
      <a href="https://calendly.com/jose-ubik360/30min" target="_blank" rel="noopener" class="btn-primary" style="font-size:1rem; padding:1rem 2.5rem;">
        Agenda tu Consulta Gratuita
      </a>
    </div>
  </section>

  <script>
    document.querySelectorAll('.faq-question').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item');
        const isOpen = item?.classList.contains('open');
        document.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('open'));
        if (!isOpen) item?.classList.add('open');
      });
    });

    const form = document.getElementById('expansion-form') as HTMLFormElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Enviando…';
      fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
        .then((res) => {
          if (res.ok) {
            window.location.href = '/es/gracias.html';
          } else {
            btn.disabled = false;
            btn.textContent = 'Descargar Checklist Gratis';
            alert('Hubo un problema. Por favor intenta de nuevo.');
          }
        })
        .catch(() => {
          btn.disabled = false;
          btn.textContent = 'Descargar Checklist Gratis';
          alert('Error de conexión. Intenta de nuevo.');
        });
    });
  </script>
</Layout>
