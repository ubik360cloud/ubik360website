    <span class="section-tag mb-4">Contacto (placeholder)</span>
    <h1 class="text-4xl mb-5" style="color:var(--black);">Contenido pendiente de portar</h1>
    <p class="text-lg mb-8" style="color:#4b5563;">Usar en/contact.astro como plantilla estructural.</p>
    <a href="https://calendly.com/jose-ubik360/30min" target="_blank" rel="noopener" class="btn-primary">Agenda una Llamada</a>
  </section>
</Layout>
