---
import Layout from '../../../layouts/Layout.astro';
// NEW (2026-09): segunda página de industria bajo Soluciones de IA (después
// de Automotriz) -- vive en Soluciones de IA > Industrias > Ecommerce, no
// un ítem de nav nuevo, mismo patrón que automotriz.astro. Sigue la misma
// estructura simple de automotriz.astro (sin stat strip, sin descarga con
// formulario, solo el CTA de diagnóstico por Calendly) -- confirmado con
// Jose 2026-09: "Same as automotriz".
// Reutiliza el hero de ecommerce.astro (EN) en vez de generar uno nuevo --
// mismo patrón que automotriz.astro reutilizando auto-dealership-hero.jpg.

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Necesito estar vendiendo en varios canales ya para trabajar con ustedes?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Algunas marcas empiezan en un solo canal y necesitan ayuda para expandirse; otras ya están en Amazon o Mercado Libre pero los sistemas de inventario, pedidos o atención al cliente no dan abasto. El diagnóstico inicial confirma exactamente dónde está tu operación hoy.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Es lo mismo que un chatbot genérico de atención al cliente?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Un chatbot genérico responde con guiones fijos y frustra al cliente en cuanto la pregunta se sale del script. Lo que construimos se integra con tu inventario y tus pedidos reales — sabe el estado real de una orden, no una respuesta genérica.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Funciona con las plataformas que ya usamos (Shopify, WooCommerce, marketplaces)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'En la mayoría de los casos sí, lo conectamos directamente. El diagnóstico inicial confirma qué se puede integrar directamente y qué requiere un ajuste — nunca prometemos una integración antes de confirmarla.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Cuánto cuesta esto para una marca de ecommerce en Colombia o Latinoamérica?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Depende del alcance — desde automatizar un proceso puntual (seguimiento de pedidos, atención al cliente) hasta una integración completa de inventario, pedidos y reportes. Construimos a la medida de lo que tu operación realmente necesita y puede sostener, no una plataforma empresarial de EE.UU. adaptada a la fuerza. El diagnóstico gratuito define alcance y costo antes de empezar.',
      },
    },
  ],
};
---

<Layout
  lang="es"
  path="/es/soluciones-ia/ecommerce.html"
  title="IA para Ecommerce | Ubik 360"
  description="Sistemas de IA confiables, integrales y a la medida para marcas de ecommerce — atención al cliente inteligente, sincronización de inventario y pedidos, e integración de sistemas. No es un chatbot genérico."
  structuredData={faqSchema}
>
  <!-- HERO: banner de ancho completo -->
  <section class="relative" style="overflow:hidden;">
    <img
      src="/assets/images/stock/ecommerce-industry-hero.jpg"
      alt="Estantería de bodega con cajas de envío apiladas"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0" style="background:linear-gradient(rgba(5,5,5,.5), rgba(5,5,5,.5)), linear-gradient(100deg, rgba(5,5,5,.92) 0%, rgba(5,5,5,.78) 38%, rgba(5,5,5,.35) 68%, rgba(5,5,5,.15) 100%);"></div>
    <div class="relative max-w-6xl mx-auto px-6 flex items-center" style="min-height:32rem; padding:6rem 1.5rem;">
      <div class="max-w-xl">
        <span class="section-tag mb-4" style="color:var(--oak);">Ecommerce</span>
        <h1 class="text-4xl lg:text-5xl leading-tight mb-5" style="color:#fff;">
          Sistemas de IA reales para tu ecommerce — no un chatbot que frustra a tus clientes.
        </h1>
        <p class="text-lg leading-relaxed mb-8" style="color:#e5e7eb;">
          Atención al cliente inteligente, sincronización de inventario y pedidos, e integración
          de sistemas — construidos para cómo realmente opera tu marca: confiables, integrales, y
          a la medida de tu presupuesto.
        </p>
        <a href="https://calendly.com/meet-ubik360/30min" target="_blank" rel="noopener" class="btn-primary">Agenda un Diagnóstico Gratuito</a>
      </div>
    </div>
  </section>

  <!-- EL PROBLEMA -->
  <section style="background:#fff; padding:4rem 0;">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p style="font-size:1.0625rem; color:#374151; line-height:1.8;">
        La mayoría de las marcas de ecommerce en Latinoamérica ya intentaron un chatbot genérico —
        y terminaron frustrando más clientes de los que ayudaron. El problema real casi nunca es
        "necesitamos IA". Es que los pedidos se procesan a mano, el inventario en tus canales no
        coincide con lo que realmente tienes disponible, y tus sistemas de ventas, inventario y
        atención al cliente no se hablan entre sí.
      </p>
    </div>
  </section>

  <!-- LO QUE CONSTRUIMOS -->
  <section style="background:var(--oak); padding:4rem 0;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-10">
        <span class="section-tag mb-3" style="color:var(--red);">Lo Que Construimos</span>
        <h2 class="text-3xl lg:text-4xl mb-4" style="color:var(--black);">Sistemas construidos para vender, no para impresionar en una demo.</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div style="background:#fff; border-radius:.875rem; padding:1.75rem;">
          <h3 class="text-lg mb-2" style="color:var(--black);">Atención al Cliente Inteligente</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.65;">Responde de inmediato por WhatsApp o web, con el estado real de cada pedido — no una respuesta genérica de script.</p>
        </div>
        <div style="background:#fff; border-radius:.875rem; padding:1.75rem;">
          <h3 class="text-lg mb-2" style="color:var(--black);">Sincronización de Inventario</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.65;">Tus canales reflejan lo que realmente tienes disponible — los productos agotados se retiran automáticamente en todas partes.</p>
        </div>
        <div style="background:#fff; border-radius:.875rem; padding:1.75rem;">
          <h3 class="text-lg mb-2" style="color:var(--black);">Integración de Sistemas</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.65;">Conectamos tu tienda, marketplaces, pagos y facturación en un solo flujo — sin reingresar la misma información varias veces.</p>
        </div>
        <div style="background:#fff; border-radius:.875rem; padding:1.75rem;">
          <h3 class="text-lg mb-2" style="color:var(--black);">Reportes en Tiempo Real</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.65;">Un panel claro que reúne datos de sistemas que hoy están desconectados, para saber qué está funcionando sin esperar un informe mensual.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- NUESTRO ENFOQUE (asimétrico) -->
  <section style="background:#fff; padding:4rem 0;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
        <div>
          <span class="section-tag mb-3">Nuestro Enfoque</span>
          <h2 class="text-3xl lg:text-4xl mb-6" style="color:var(--black);">Primero entendemos tu operación. Después construimos la tecnología.</h2>
          <div style="display:flex; flex-direction:column; gap:1.25rem; font-size:1.0625rem; color:#374151; line-height:1.85;">
            <p>
              Antes de proponer un solo sistema, entendemos qué genera ingresos en tu operación —
              qué canales y productos convierten mejor, qué tan rápido puedes cumplir un pedido — y
              qué está comiendo margen: procesos manuales, inventario desincronizado, tiempo del
              equipo en tareas que un sistema puede hacer solo.
            </p>
            <p>
              Construimos sistemas confiables — no una demo que se ve bien pero falla en
              producción — con una perspectiva integral de tu operación completa, y a un costo
              accesible para la realidad de una marca en Latinoamérica, no una plataforma
              empresarial diseñada para el mercado de EE.UU. adaptada a la fuerza.
            </p>
          </div>
        </div>
        <img
          src="/assets/images/stock/marketing-analytics-dashboard.jpg"
          alt="Panel de análisis de marketing"
          class="w-full rounded-xl object-cover aspect-[4/3]"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- NO TODO ES UN PROBLEMA DE TECNOLOGÍA (rojo) -->
  <section style="background:var(--red); padding:4rem 0;">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="section-tag mb-3" style="color:#fff; opacity:.85;">Honestidad Antes que Venta</span>
      <h2 class="text-3xl lg:text-4xl mb-6" style="color:#fff;">No todo es un problema de tecnología.</h2>
      <p style="font-size:1.0625rem; color:rgba(255,255,255,.88); line-height:1.85;">
        Algunas marcas necesitan un sistema mejor. Otras necesitan un proceso más claro para
        cumplir pedidos, o simplemente una persona responsable de ejecutarlo — eso no se resuelve
        con más tecnología. Antes de construir una sola línea de código, te decimos con claridad
        cuál es tu caso, incluso cuando la respuesta honesta es que todavía no necesitas construir
        nada nuevo.
      </p>
    </div>
  </section>

  <!-- PROCESO -->
  <section style="background:#f9fafb; padding:4rem 0;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-xl mb-12">
        <span class="section-tag mb-3">El Proceso</span>
        <h2 class="text-3xl lg:text-4xl" style="color:var(--black);">Cómo trabajamos</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div>
          <div style="width:3rem; height:3rem; border-radius:9999px; border:2px solid var(--red); display:flex; align-items:center; justify-content:center; margin-bottom:1.25rem;">
            <span style="font-family:'DM Serif Display',serif; font-size:1.25rem; color:var(--red);">1</span>
          </div>
          <h3 style="font-family:'DM Serif Display',serif; font-size:1.0625rem; color:var(--black); margin:0 0 .5rem;">Diagnóstico</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.65;">Entendemos tu operación real: qué genera ingresos, dónde se pierde tiempo, y qué se puede automatizar primero.</p>
        </div>
        <div>
          <div style="width:3rem; height:3rem; border-radius:9999px; border:2px solid var(--red); display:flex; align-items:center; justify-content:center; margin-bottom:1.25rem;">
            <span style="font-family:'DM Serif Display',serif; font-size:1.25rem; color:var(--red);">2</span>
          </div>
          <h3 style="font-family:'DM Serif Display',serif; font-size:1.0625rem; color:var(--black); margin:0 0 .5rem;">Diseño de la Solución</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.65;">Definimos exactamente qué se va a construir, con qué alcance, y qué resultado esperar.</p>
        </div>
        <div>
          <div style="width:3rem; height:3rem; border-radius:9999px; border:2px solid var(--red); display:flex; align-items:center; justify-content:center; margin-bottom:1.25rem;">
            <span style="font-family:'DM Serif Display',serif; font-size:1.25rem; color:var(--red);">3</span>
          </div>
          <h3 style="font-family:'DM Serif Display',serif; font-size:1.0625rem; color:var(--black); margin:0 0 .5rem;">Construcción</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.65;">Construimos e integramos el sistema directamente con tu tienda, marketplaces y procesos actuales.</p>
        </div>
        <div>
          <div style="width:3rem; height:3rem; border-radius:9999px; border:2px solid var(--red); display:flex; align-items:center; justify-content:center; margin-bottom:1.25rem;">
            <span style="font-family:'DM Serif Display',serif; font-size:1.25rem; color:var(--red);">4</span>
          </div>
          <h3 style="font-family:'DM Serif Display',serif; font-size:1.0625rem; color:var(--black); margin:0 0 .5rem;">Acompañamiento</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.65;">Ajustamos el sistema con datos reales de uso — no lo dejamos solo después de entregarlo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="background:#fff; padding:4rem 0;">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-12">
        <span class="section-tag mb-3">Preguntas Frecuentes</span>
        <h2 class="text-3xl lg:text-4xl" style="color:var(--black);">Lo que más preguntan</h2>
      </div>
      <div id="faq-list">
        <div class="faq-item">
          <button class="faq-question">
            ¿Necesito estar vendiendo en varios canales ya para trabajar con ustedes?
            <svg class="faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="faq-answer">No. Algunas marcas empiezan en un solo canal y necesitan ayuda para expandirse; otras ya están en Amazon o Mercado Libre pero los sistemas de inventario, pedidos o atención al cliente no dan abasto. El diagnóstico inicial confirma exactamente dónde está tu operación hoy.</div>
        </div>
        <div class="faq-item">
          <button class="faq-question">
            ¿Es lo mismo que un chatbot genérico de atención al cliente?
            <svg class="faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="faq-answer">No. Un chatbot genérico responde con guiones fijos y frustra al cliente en cuanto la pregunta se sale del script. Lo que construimos se integra con tu inventario y tus pedidos reales — sabe el estado real de una orden, no una respuesta genérica.</div>
        </div>
        <div class="faq-item">
          <button class="faq-question">
            ¿Funciona con las plataformas que ya usamos (Shopify, WooCommerce, marketplaces)?
            <svg class="faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="faq-answer">En la mayoría de los casos sí, lo conectamos directamente. El diagnóstico inicial confirma qué se puede integrar directamente y qué requiere un ajuste — nunca prometemos una integración antes de confirmarla.</div>
        </div>
        <div class="faq-item">
          <button class="faq-question">
            ¿Cuánto cuesta esto para una marca de ecommerce en Colombia o Latinoamérica?
            <svg class="faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="faq-answer">Depende del alcance — desde automatizar un proceso puntual (seguimiento de pedidos, atención al cliente) hasta una integración completa de inventario, pedidos y reportes. Construimos a la medida de lo que tu operación realmente necesita y puede sostener, no una plataforma empresarial de EE.UU. adaptada a la fuerza. El diagnóstico gratuito define alcance y costo antes de empezar.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA: banner de ancho completo -->
  <section class="relative" style="overflow:hidden;">
    <img
      src="/assets/images/stock/ecommerce-industry-hero.jpg"
      alt="Estantería de bodega con cajas de envío apiladas"
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0" style="background:rgba(5,5,5,.8);"></div>
    <div class="relative max-w-3xl mx-auto px-6 text-center" style="padding:6rem 1.5rem;">
      <span class="section-tag mb-4" style="color:var(--oak);">Da el Primer Paso</span>
      <h2 class="text-3xl lg:text-4xl mb-5" style="color:#fff;">¿Listo para automatizar tu ecommerce de verdad?</h2>
      <p style="color:#e5e7eb; font-size:1.125rem; line-height:1.7; max-width:30rem; margin:0 auto 2.5rem;">
        Una llamada de 30 minutos para entender tu operación y mostrarte qué es realmente posible.
        Sin costo, sin compromiso.
      </p>
      <a href="https://calendly.com/meet-ubik360/30min" target="_blank" rel="noopener" class="btn-primary" style="font-size:1rem; padding:1rem 2.5rem;">
        Agenda tu Diagnóstico Gratuito
      </a>
    </div>
  </section>

  <script>
    document.querySelectorAll('.faq-question').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item');
        const isOpen = item?.classList.contains('open');
        document.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('open'));
        if (!isOpen) item?.classList.add('open');
      });
    });
  </script>
</Layout>
