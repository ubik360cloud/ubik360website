---
import Layout from '../../layouts/Layout.astro';
// TODO(content): legacy version was specific to the "Hispanic Market
// Accelerator" lead magnet on the old digital-marketing.html. That page's
// content is being rewritten (see MARKETING.md), so this is a generic
// placeholder until the new lead magnets/CTAs for each rewritten page are set.
---

<Layout
  lang="en"
  path="/en/thank-you.html"
  title="Thank You | Ubik 360"
  description="Thanks for reaching out."
>
  <section style="background:#fff; min-height:calc(100vh - 4rem); display:flex; align-items:center; padding:5rem 0;">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <span class="section-tag mb-4" style="display:block;">Confirmed</span>
      <h1 class="text-4xl lg:text-5xl mb-5" style="color:var(--black);">Thanks — got it.</h1>
      <p style="color:#4b5563; font-size:1.125rem; line-height:1.75; max-width:32rem; margin:0 auto 2.5rem;">
        I'll be in touch within 24 hours. In the meantime, feel free to grab a spot on my calendar.
      </p>
      <a href="https://calendly.com/jose-ubik360/30min" target="_blank" rel="noopener" class="btn-primary">Book a Free 30-Minute Call</a>
      <p style="margin-top:3rem;">
        <a href="/en/index.html" style="font-size:.875rem; color:#9ca3af;">← Back to home</a>
      </p>
    </div>
  </section>
</Layout>
