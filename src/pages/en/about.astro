---
import Layout from '../../layouts/Layout.astro';
// TEMPORARY TEST VARIANT (2026-07, Jose) -- replaces the personal About page
// with an anonymous team page for the "bigger company" positioning test.
// See MARKETING.md "Anonymous/bigger-company positioning test" for full
// context and the revert plan (real plan: Jose as President/CEO, named,
// not hidden -- just not "Founder"/solopreneur-framed).

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Ubik 360 Enterprises',
  url: 'https://ubik360.com',
  description:
    'Marketing, sales, and international business operations leadership for companies growing across Colombia, the U.S., and Canada.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '30 N Gould St Ste R',
    addressLocality: 'Sheridan',
    addressRegion: 'WY',
    postalCode: '82801',
    addressCountry: 'US',
  },
};
---

<Layout
  lang="en"
  path="/en/about.html"
  alternatePath="/es/sobre-mi.html"
  title="Our Team | Ubik 360"
  description="Ubik 360's leadership brings together marketing, sales, and international business operations professionals working across Colombia, the U.S., and Canada."
  structuredData={orgSchema}
>
  <!-- 1. POSITIONING: full-width banner -->
  <section class="relative" style="overflow:hidden;">
    <img
      src="/assets/images/stock/marketing-team-meeting.jpg"
      alt="Marketing team in a meeting"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0" style="background:linear-gradient(180deg, rgba(5,5,5,.72) 0%, rgba(5,5,5,.85) 100%);"></div>
    <div class="relative max-w-3xl mx-auto px-6 text-center" style="padding:7rem 1.5rem 5rem;">
      <span class="section-tag mb-4" style="display:block; color:var(--oak);">Our Team</span>
      <h1 class="text-4xl lg:text-5xl leading-tight mb-6" style="color:#fff;">
        Built for growth on both sides of the border.
      </h1>
      <p style="font-size:1.125rem; color:#e5e7eb; line-height:1.8;">
        Ubik 360's leadership is composed of professionals in marketing, sales, and international
        business operations. We work as one accountable team, not a loose network of
        subcontractors — every engagement is run with direct oversight, start to finish.
      </p>
    </div>
  </section>

  <!-- 2. APPROACH (asymmetric: text left, image right) -->
  <section style="background:#f9fafb; padding:4rem 0;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
        <div>
          <span class="section-tag mb-3">How We Work</span>
          <h2 class="text-3xl lg:text-4xl mb-6" style="color:var(--black);">The work speaks before we do.</h2>
          <div style="display:flex; flex-direction:column; gap:1.25rem; font-size:1.0625rem; color:#374151; line-height:1.85;">
            <p>
              We'd rather walk into a first conversation prepared to answer hard questions about your
              business than spend it building rapport. Clients don't need a great pitch, they need a
              team that's done the homework and can say plainly what's working, what isn't, and what
              to do next.
            </p>
            <p>
              That means no inflated timelines, no vague promises, and no dressing up a weak plan to
              make a first call go smoothly. If something isn't going to work, you hear that in the
              first conversation — not three months into a retainer.
            </p>
          </div>
        </div>
        <img
          src="/assets/images/stock/sales-funnel-whiteboard.jpg"
          alt="Sales strategy on a whiteboard"
          class="w-full rounded-xl object-cover aspect-[4/3]"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- 3. LEADERSHIP COMPOSITION -->
  <section style="background:#fff; padding:4rem 0;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-10">
        <span class="section-tag mb-3">Leadership</span>
        <h2 class="text-3xl lg:text-4xl mb-4" style="color:var(--black);">A team built around each engagement.</h2>
        <p style="font-size:1.0625rem; color:#4b5563; line-height:1.8;">
          Ubik 360's leadership team brings together marketing strategy, sales leadership, and
          international business operations — hands-on experience building go-to-market strategy,
          growth marketing, and cross-border expansion for companies in Colombia, the U.S., and
          Canada.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="service-card">
          <h3 class="text-lg mb-2" style="color:var(--black);">Marketing &amp; Growth</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.65;">Fractional CMO leadership, go-to-market strategy, and growth marketing execution.</p>
        </div>
        <div class="service-card">
          <h3 class="text-lg mb-2" style="color:var(--black);">Product &amp; Design</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.65;">UX/UI designers with product experience across startups and SaaS companies.</p>
        </div>
        <div class="service-card">
          <h3 class="text-lg mb-2" style="color:var(--black);">Paid Media Partner</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.65;">A growth-marketing partner specializing in paid media, working alongside our content and SEO practice.</p>
        </div>
        <div class="service-card">
          <h3 class="text-lg mb-2" style="color:var(--black);">Market Research</h3>
          <p style="font-size:.875rem; color:#4b5563; line-height:1.65;">An economist fluent in English, Spanish, and French, with deep experience in Colombian government contracts.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. CROSS-BORDER ADVANTAGE -->
  <section style="background:var(--oak); padding:4rem 0;">
    <div class="max-w-4xl mx-auto px-6">
      <span class="section-tag mb-3" style="color:var(--red); display:block; text-align:center;">Cross-Border &amp; Bilingual</span>
      <h2 class="text-3xl lg:text-4xl mb-6 text-center" style="color:var(--black);">Not a service category. Daily practice.</h2>
      <div style="display:flex; flex-direction:column; gap:1.25rem; font-size:1.0625rem; color:#3d3d3d; line-height:1.85;">
        <p>
          Our team lives and works across Colombia, the U.S., and Canada. That's not a
          credential — it's the reality that makes the bilingual, bicultural side of this work
          second nature instead of theoretical.
        </p>
        <p>
          Practically, that means positioning, messaging, and go-to-market plans get built with
          real cultural and regulatory fluency, not translated after the fact — whether the
          direction is a Colombian company entering the U.S. or Canadian market, or a North
          American company building a team or reaching a market in Latin America.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. CLOSING CTA (white -- keeps a black-on-black seam from forming against the footer) -->
  <section style="background:#fff; padding:4rem 0;">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <span class="section-tag mb-4">Let's Talk</span>
      <h2 class="text-3xl lg:text-4xl mb-5" style="color:var(--black);">Is your business ready to move?</h2>
      <p style="color:#4b5563; font-size:1.125rem; line-height:1.7; max-width:30rem; margin:0 auto 2.5rem;">
        If your business is ready for marketing that performs, staff you can rely on, or a real
        plan to cross into a new market — let's talk. Thirty minutes is enough to know if it's a
        fit.
      </p>
      <a href="https://calendly.com/meet-ubik360/30min" target="_blank" rel="noopener" class="btn-primary" style="font-size:1rem; padding:1rem 2.5rem;">
        Schedule a Growth Call
      </a>
    </div>
  </section>
</Layout>
