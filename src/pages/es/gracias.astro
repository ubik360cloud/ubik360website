---
import Layout from '../../layouts/Layout.astro';
// Generic Spanish thank-you page (mirrors en/thank-you.astro), used by both
// es/contacto.astro and es/expansion-internacional.astro's lead form.
// Lead-magnet form appends ?guide=<key> to the redirect URL so this one page
// can still deliver the right file -- GUIDES maps that key to the actual
// asset in public/assets/downloads/. No query param (plain contact-form
// case) -> the download block stays hidden.
const GUIDES: Record<string, { title: string; href: string }> = {
  'checklist-incorporacion': {
    title: 'Checklist de Incorporación 2026',
    href: '/assets/downloads/checklist-incorporacion-usa-ubik360.html',
  },
};
---

<Layout
  lang="es"
  path="/es/gracias.html"
  title="Gracias | Ubik 360"
  description="Gracias por contactarnos."
>
  <section style="background:#fff; min-height:calc(100vh - 4rem); display:flex; align-items:center; padding:4rem 0;">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <span class="section-tag mb-4" style="display:block;">Confirmado</span>
      <h1 class="text-4xl lg:text-5xl mb-5" style="color:var(--black);">Gracias — recibido.</h1>
      <p style="color:#4b5563; font-size:1.125rem; line-height:1.75; max-width:32rem; margin:0 auto 2.5rem;">
        Te contactaremos en menos de 24 horas. Mientras tanto, puedes agendar un espacio en
        nuestro calendario.
      </p>

      <div id="guide-download" class="hidden" style="margin-bottom:2rem;">
        <div style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:.875rem; padding:1.75rem; max-width:26rem; margin:0 auto;">
          <p style="font-size:.75rem; color:#9ca3af; text-transform:uppercase; letter-spacing:.1em; margin:0 0 .5rem;">Tu Guía Gratuita</p>
          <p id="guide-title" style="font-family:'DM Serif Display',serif; font-size:1.125rem; color:var(--black); margin:0 0 1.125rem;"></p>
          <a id="guide-link" href="#" class="btn-primary" style="width:100%; display:block;">Abrir tu Guía</a>
        </div>
      </div>

      <a href="https://calendly.com/jose-ubik360/30min" target="_blank" rel="noopener" class="btn-outline">Agenda tu Llamada Gratuita</a>
      <p style="margin-top:3rem;">
        <a href="/es/index.html" style="font-size:.875rem; color:#9ca3af;">← Volver al inicio</a>
      </p>
    </div>
  </section>

  <script define:vars={{ guides: GUIDES }}>
    const key = new URLSearchParams(window.location.search).get('guide');
    const guide = key && guides[key];
    if (guide) {
      document.getElementById('guide-download')?.classList.remove('hidden');
      document.getElementById('guide-title').textContent = guide.title;
      const link = document.getElementById('guide-link');
      link.href = guide.href;
      link.target = '_blank';
      link.rel = 'noopener';
    }
  </script>
</Layout>
