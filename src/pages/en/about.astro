---
import Layout from '../../layouts/Layout.astro';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'José Manuel Villegas',
  jobTitle: 'Founder & Consultant — Ubik 360',
  description:
    'Entrepreneur with 15+ years of experience in digital marketing and international business expansion across Colombia, the U.S., and Canada.',
  url: 'https://ubik360.com/en/about.html',
  image: 'https://ubik360.com/assets/images/jose-villegas.png',
  sameAs: ['https://www.linkedin.com/in/jose-villegas-marketing-manager/'],
  worksFor: { '@type': 'Organization', name: 'Ubik 360', url: 'https://ubik360.com' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Florida International University', address: { '@type': 'PostalAddress', addressLocality: 'Miami', addressRegion: 'FL', addressCountry: 'US' } },
    { '@type': 'CollegeOrUniversity', name: 'Universidad de La Salle', address: { '@type': 'PostalAddress', addressLocality: 'Bogotá', addressCountry: 'CO' } },
    { '@type': 'CollegeOrUniversity', name: 'Fanshawe College', address: { '@type': 'PostalAddress', addressLocality: 'London', addressRegion: 'ON', addressCountry: 'CA' } },
  ],
  knowsLanguage: ['en', 'es'],
  nationality: 'Colombian',
};
---

<Layout
  lang="en"
  path="/en/about.html"
  alternatePath="/es/sobre-mi.html"
  title="About | José Villegas | Ubik 360"
  description="15+ years building businesses in Colombia, the U.S., and Canada. Entrepreneur, CMO, and international expansion consultant. The story behind Ubik 360."
  ogImage="https://ubik360.com/assets/images/jose-villegas.png"
  structuredData={personSchema}
>
  <!-- HERO -->
  <section style="background:#fff; padding:5rem 0 4rem; overflow:hidden;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-col lg:flex-row items-center lg:items-end gap-10">
        <div class="flex-1 max-w-xl">
          <span class="section-tag mb-4">About</span>
          <h1 class="text-4xl lg:text-5xl leading-tight mb-5" style="color:var(--black);">
            I've Built in Every<br />Market I Consult In.
          </h1>
          <p class="text-xl leading-relaxed mb-6" style="color:#4b5563;">
            I'm not a consultant who read about these markets in a book. I've built real businesses in Colombia, the U.S., and Canada—with my own money, my own team, and my own skin in the game.
          </p>
          <div style="display:flex; flex-wrap:wrap; gap:.625rem; margin-bottom:2rem;">
            <span style="display:inline-flex; align-items:center; gap:.375rem; font-size:.8125rem; font-weight:600; color:var(--green); border:1px solid rgba(101,145,87,.35); background:rgba(101,145,87,.08); border-radius:9999px; padding:.25rem .875rem;">
              <img src="https://flagcdn.com/16x12/co.png" width="16" height="12" alt="" style="border-radius:1px;" /> Barranquilla, Colombia
            </span>
            <span style="display:inline-flex; align-items:center; gap:.375rem; font-size:.8125rem; font-weight:600; color:var(--green); border:1px solid rgba(101,145,87,.35); background:rgba(101,145,87,.08); border-radius:9999px; padding:.25rem .875rem;">
              <img src="https://flagcdn.com/16x12/us.png" width="16" height="12" alt="" style="border-radius:1px;" /> Miami &amp; Las Vegas, U.S.
            </span>
            <span style="display:inline-flex; align-items:center; gap:.375rem; font-size:.8125rem; font-weight:600; color:var(--green); border:1px solid rgba(101,145,87,.35); background:rgba(101,145,87,.08); border-radius:9999px; padding:.25rem .875rem;">
              <img src="https://flagcdn.com/16x12/ca.png" width="16" height="12" alt="" style="border-radius:1px;" /> London, Ontario, Canada
            </span>
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="https://calendly.com/jose-ubik360/30min" target="_blank" rel="noopener" class="btn-primary">Schedule a Call</a>
            <a href="https://www.linkedin.com/in/jose-villegas-marketing-manager/" target="_blank" rel="noopener" class="btn-outline">View LinkedIn</a>
          </div>
        </div>
        <div class="flex-shrink-0" style="position:relative;">
          <div style="position:absolute; inset:-1rem; background:var(--oak); border-radius:1.25rem; z-index:0;"></div>
          <img
            src="https://ubik360.com/assets/images/jose-villegas.png"
            alt="José Villegas — Founder of Ubik 360"
            class="w-56 lg:w-64 rounded-xl object-cover"
            style="position:relative; z-index:1;"
            loading="eager"
          />
        </div>
      </div>
    </div>
    <div style="height:3px; background:linear-gradient(to right, transparent, var(--oak), transparent); margin-top:4rem;"></div>
  </section>

  <!-- STATS -->
  <section style="background:var(--black); padding:3rem 0;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 lg:grid-cols-5 gap-8 text-center">
        <div>
          <p class="text-3xl font-bold mb-1" style="font-family:'DM Serif Display',serif; color:var(--red);">15+</p>
          <p style="color:#9ca3af; font-size:.8125rem; line-height:1.5;">years in business<br />across three countries</p>
        </div>
        <div>
          <p class="text-3xl font-bold mb-1" style="font-family:'DM Serif Display',serif; color:var(--red);">3</p>
          <p style="color:#9ca3af; font-size:.8125rem; line-height:1.5;">countries where I've<br />lived, studied &amp; built</p>
        </div>
        <div>
          <p class="text-3xl font-bold mb-1" style="font-family:'DM Serif Display',serif; color:var(--red);">$10M+</p>
          <p style="color:#9ca3af; font-size:.8125rem; line-height:1.5;">in revenue under<br />active management</p>
        </div>
        <div>
          <p class="text-3xl font-bold mb-1" style="font-family:'DM Serif Display',serif; color:var(--red);">37</p>
          <p style="color:#9ca3af; font-size:.8125rem; line-height:1.5;">companies incorporated<br />internationally</p>
        </div>
        <div>
          <p class="text-3xl font-bold mb-1" style="font-family:'DM Serif Display',serif; color:var(--red);">~20</p>
          <p style="color:#9ca3af; font-size:.8125rem; line-height:1.5;">books read<br />every year</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MY STORY -->
  <section style="background:#fff; padding:5rem 0;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-col lg:flex-row gap-14 items-start">
        <div class="flex-1 max-w-2xl">
          <span class="section-tag mb-3">My Story</span>
          <h2 class="text-3xl lg:text-4xl mb-8" style="color:var(--black);">Entrepreneurship isn't what I do.<br /><em style="color:var(--red);">It's who I am.</em></h2>
          <div style="display:flex; flex-direction:column; gap:1.5rem; font-size:1.0625rem; color:#374151; line-height:1.85;">
            <p>I studied Business Administration at <strong style="color:var(--black);">Florida International University</strong> in Miami in the late '90s. That timing wasn't a coincidence—it was a privilege. I was in Miami when commercial internet was being born. My generation didn't read about the dot-com boom in textbooks. We lived it. I lived it.</p>
            <p>I went back to Colombia and joined one of the first digital businesses operating in the country. The world was changing faster than most companies could adapt. I learned that early—and it has shaped every decision I've made since.</p>
            <p>Between 2010 and 2012, I spent nearly two years out of work. Instead of waiting it out, I used that time to design my next move. In <strong style="color:var(--black);">2013, I founded Panamerican Logix Corp.</strong> in Miami—importing cowhide rugs from Colombia and selling them in the U.S. I started with local sales, then broke into TJ Maxx. Then Amazon, Wayfair, Overstock, and Sam's Club. Four years later, I had grown the business from <strong style="color:var(--black);">zero to $1 million in revenue</strong>—and that same business earned me an investor visa to return to the U.S. in 2018.</p>
            <p>Then COVID rewrote the plan. I went back to Colombia. I became Digital Strategy Director at <strong style="color:var(--black);">Gecolsa Caterpillar</strong>, then CMO of a SaaS company I helped scale to <strong style="color:var(--black);">$5 million in revenue</strong>. From there: CMO and now President of an e-commerce company doing <strong style="color:var(--black);">$10M+ in annual sales</strong>—a role I still hold today. My most recent engagement: an online university licensed in Orlando, Florida, where I'm designing and leading the entire go-to-market strategy.</p>
            <p>In 2023 I made what I call the most human decision of my career: <strong style="color:var(--black);">I moved to Canada with my family</strong> because my daughter went to school there. I enrolled in a postgraduate program at Fanshawe College. My younger son finished high school there. My wife built international operations experience. I learned Canada from the inside—not as a tourist, but as a resident who paid rent, opened accounts, and built real relationships.</p>
            <p>Today I split my time between <strong style="color:var(--black);">Barranquilla, my hometown</strong>, and <strong style="color:var(--black);">London, Ontario</strong>, where my kids live. That unique position—having genuinely lived, studied, and built businesses in all three countries—is where Ubik 360 was born.</p>
          </div>
        </div>
        <div class="flex-shrink-0 lg:w-80">
          <div style="border-left:3px solid var(--red); padding:.75rem 1.25rem; background:rgba(147,31,29,.04); border-radius:0 .5rem .5rem 0; font-style:italic; font-size:1.0625rem; color:var(--black); line-height:1.7; margin-bottom:2rem;">
            "I worked for large companies because it was the most accessible way to keep learning. But always with one eye on my own projects and my own vision."
          </div>
          <div style="background:var(--oak); border-radius:1rem; padding:1.75rem; margin-bottom:1.5rem;">
            <h3 style="font-family:'DM Serif Display',serif; font-size:1.25rem; color:var(--black); margin:0 0 .875rem;">My Purpose</h3>
            <p style="font-size:.9375rem; color:#3d3d3d; line-height:1.75; margin:0 0 1rem;">
              Helping Hispanic-owned businesses scale. In the U.S. and Canada, many Latino businesses have the talent and drive—but lack structure and strategic backing. In Colombia, companies have the product and the ambition, but language barriers and unfamiliarity with international markets hold them back.
            </p>
            <p style="font-size:.9375rem; color:#3d3d3d; line-height:1.75; margin:0; font-weight:500;">
              I have what they're missing. And I feel an obligation to share it.
            </p>
          </div>
          <a
            href="https://www.linkedin.com/in/jose-villegas-marketing-manager/"
            target="_blank"
            rel="noopener"
            style="display:flex; align-items:center; gap:.75rem; padding:1rem 1.25rem; border:1px solid #e5e7eb; border-radius:.75rem; transition:border-color .2s, box-shadow .2s;"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="#0077b5"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
            <div>
              <p style="font-size:.875rem; font-weight:600; color:var(--black); margin:0;">José Villegas</p>
              <p style="font-size:.75rem; color:#6b7280; margin:0;">View LinkedIn profile</p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CAREER TIMELINE -->
  <section style="background:var(--black); padding:5rem 0;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-col lg:flex-row gap-14">
        <div class="lg:w-80 flex-shrink-0">
          <span class="section-tag mb-3" style="color:var(--oak);">Career</span>
          <h2 class="text-3xl lg:text-4xl mb-4" style="color:#fff;">25 years building,<br />learning,<br />scaling.</h2>
          <p style="color:#9ca3af; font-size:.9375rem; line-height:1.75;">
            Every role was a school. Every company was a lab. What I offer today isn't theory—it's the result of 25 years of real-world practice across three countries and multiple industries.
          </p>
        </div>
        <div class="flex-1">
          <div style="position:relative; padding-left:2rem;">
            <div style="position:absolute; left:.4375rem; top:.5rem; bottom:.5rem; width:2px; background:linear-gradient(to bottom, var(--red), rgba(147,31,29,.15));"></div>

            {[
              { year: '2025 — Present', role: 'President & Contractor CMO', company: 'Online Print Properties (Overnightprints.com) · Las Vegas, U.S. (Remote)', detail: 'Global direction of strategy, sales, and market expansion. $10M+ in annual revenue.', active: true },
              { year: '2025 — Present', role: 'Contractor CMO', company: 'Online University · Orlando, FL (U.S.-licensed, Colombian founder)', detail: 'Designing and leading the go-to-market strategy for student enrollment.', active: true },
              { year: '2023 — 2024', role: 'Postgraduate Studies + Industry Roles', company: 'Fanshawe College · London, Ontario, Canada', detail: 'Studied Public Relations & Corporate Communications. Simultaneously worked as Account Manager and Senior Marketing Specialist at Canadian companies. Learned Canada from the inside.' },
              { year: '2020 — 2022', role: 'CMO — Chief Marketing Officer', company: 'SaaS Company (Confidential) · Barranquilla, Colombia', detail: 'Board member. Scaled the company to $5M in revenue. Achieved #1 organic ranking for 5 primary keywords and expanded sales into South Africa.' },
              { year: '2019 — 2020', role: 'Digital Strategy Director', company: 'Gecolsa Caterpillar (Construction Equipment) · Barranquilla, Colombia', detail: 'Led the equipment monitoring team and designed the sales strategy for preventive maintenance agreements.' },
              { year: '2013 — 2019', role: 'VP of Sales & Operations — Founder', company: 'Panamerican Logix Corp. · Miami, FL, U.S.', detail: 'Imported cowhide rugs from Colombia. Grew from $0 to $1M in 4 years. Distribution through TJ Maxx, Amazon, Wayfair, Overstock, and Sam\'s Club. This business earned me a U.S. investor visa.' },
              { year: '2001 — 2012', role: 'Early Career — Digital & International Business', company: 'Colombia & the U.S.', detail: 'Worked in the first digital businesses operating in Colombia post-dot-com. Learned early that the world was changing faster than most companies could keep up. That lesson never left me.' },
            ].map((item) => (
              <div style="position:relative; padding-bottom:2.5rem;">
                <div style={`position:absolute; left:-1.625rem; top:.3125rem; width:.875rem; height:.875rem; border-radius:9999px; border:2px solid var(--red); background:${item.active ? 'var(--red)' : '#fff'};`}></div>
                <p style="font-size:.75rem; font-weight:700; color:var(--red); letter-spacing:.06em; margin-bottom:.25rem;">{item.year}</p>
                <p style="font-size:.9375rem; font-weight:600; color:#fff; margin-bottom:.125rem;">{item.role}</p>
                <p style="font-size:.875rem; color:#9ca3af;">{item.company}</p>
                <p style="font-size:.8125rem; color:#6b7280; line-height:1.6; margin-top:.375rem;">{item.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EDUCATION -->
  <section style="background:var(--oak); padding:5rem 0;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-xl mb-10">
        <span class="section-tag mb-3" style="color:var(--red);">Education</span>
        <h2 class="text-3xl lg:text-4xl mb-3" style="color:var(--black);">Three degrees.<br />Three countries.<br />One perspective you can't fake.</h2>
        <p style="color:#3d3d3d; font-size:.9375rem; line-height:1.75;">
          Academia gave me the foundation. Experience gave me the judgment. And books—around 20 a year—keep both sharp.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10">
        <div class="rounded-2xl p-7" style="background:#fff; border:1px solid #e5e7eb;">
          <img src="https://flagcdn.com/24x18/us.png" width="24" height="18" alt="United States" style="border-radius:2px; margin-bottom:.375rem;" />
          <p style="font-size:.75rem; font-weight:700; color:var(--red); text-transform:uppercase; letter-spacing:.08em; margin:0 0 .375rem;">Bachelor's Degree</p>
          <h3 style="font-family:'DM Serif Display',serif; font-size:1.0625rem; color:var(--black); margin:0 0 .25rem;">Business Administration</h3>
          <p style="font-size:.875rem; color:#4b5563; margin:0 0 .125rem;">Florida International University</p>
          <p style="font-size:.8125rem; color:#9ca3af; margin:0;">Miami, FL · 2001</p>
          <p style="font-size:.8125rem; color:#4b5563; margin:.5rem 0 0; line-height:1.6;">Studied during the dot-com era. Witnessed the birth of commercial internet in real time, in Miami.</p>
        </div>
        <div class="rounded-2xl p-7" style="background:#fff; border:1px solid #e5e7eb;">
          <img src="https://flagcdn.com/24x18/co.png" width="24" height="18" alt="Colombia" style="border-radius:2px; margin-bottom:.375rem;" />
          <p style="font-size:.75rem; font-weight:700; color:var(--red); text-transform:uppercase; letter-spacing:.08em; margin:0 0 .375rem;">Graduate Diploma</p>
          <h3 style="font-family:'DM Serif Display',serif; font-size:1.0625rem; color:var(--black); margin:0 0 .25rem;">Marketing Management</h3>
          <p style="font-size:.875rem; color:#4b5563; margin:0 0 .125rem;">Universidad de La Salle</p>
          <p style="font-size:.8125rem; color:#9ca3af; margin:0;">Bogotá, Colombia · 2011</p>
          <p style="font-size:.8125rem; color:#4b5563; margin:.5rem 0 0; line-height:1.6;">Advanced marketing strategy applied to the Latin American business context.</p>
        </div>
        <div class="rounded-2xl p-7" style="background:#fff; border:1px solid #e5e7eb;">
          <img src="https://flagcdn.com/24x18/ca.png" width="24" height="18" alt="Canada" style="border-radius:2px; margin-bottom:.375rem;" />
          <p style="font-size:.75rem; font-weight:700; color:var(--red); text-transform:uppercase; letter-spacing:.08em; margin:0 0 .375rem;">Postgraduate Certificate</p>
          <h3 style="font-family:'DM Serif Display',serif; font-size:1.0625rem; color:var(--black); margin:0 0 .25rem;">Public Relations &amp; Corporate Communications</h3>
          <p style="font-size:.875rem; color:#4b5563; margin:0 0 .125rem;">Fanshawe College</p>
          <p style="font-size:.8125rem; color:#9ca3af; margin:0;">London, Ontario · 2024</p>
          <p style="font-size:.8125rem; color:#4b5563; margin:.5rem 0 0; line-height:1.6;">Learned Canada as a resident—not a tourist. Paid rent, opened accounts, built relationships.</p>
        </div>
      </div>

      <div style="background:#fff; border-radius:1rem; padding:2rem;">
        <div class="flex flex-col lg:flex-row gap-8 items-start">
          <div class="flex-1">
            <h3 style="font-family:'DM Serif Display',serif; font-size:1.375rem; color:var(--black); margin:0 0 .75rem;">The university that never ends</h3>
            <p style="font-size:.9375rem; color:#4b5563; line-height:1.75; margin:0 0 1rem;">
              I read—or really, <em>listen</em> to—about 20 books a year. While I work out, drive, or walk. Marketing, sales, investing, leadership, biographies. Curiosity isn't a personality trait for me; it's a deliberate habit.
            </p>
            <p style="font-size:.9375rem; color:#4b5563; line-height:1.75; margin:0;">
              One recent favorite: <strong style="color:var(--black);">"Never Enough: From Barista to Billionaire"</strong> by Andrew Wilkinson. An honest look at the real cost of success—and how to define it on your own terms.
            </p>
          </div>
          <div style="flex-shrink:0; max-width:20rem; padding:1.25rem 1.5rem; background:var(--oak); border-radius:.875rem;">
            <p style="font-size:.75rem; font-weight:700; color:var(--red); text-transform:uppercase; letter-spacing:.08em; margin:0 0 .75rem;">What I'm reading this year</p>
            <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:.5rem;">
              <li style="font-size:.875rem; color:#3d3d3d; display:flex; align-items:center; gap:.5rem;"><span style="color:var(--green); font-weight:700;">→</span> Marketing &amp; Growth</li>
              <li style="font-size:.875rem; color:#3d3d3d; display:flex; align-items:center; gap:.5rem;"><span style="color:var(--green); font-weight:700;">→</span> Sales &amp; Negotiation</li>
              <li style="font-size:.875rem; color:#3d3d3d; display:flex; align-items:center; gap:.5rem;"><span style="color:var(--green); font-weight:700;">→</span> Investing &amp; Personal Finance</li>
              <li style="font-size:.875rem; color:#3d3d3d; display:flex; align-items:center; gap:.5rem;"><span style="color:var(--green); font-weight:700;">→</span> Leadership &amp; Team Management</li>
              <li style="font-size:.875rem; color:#3d3d3d; display:flex; align-items:center; gap:.5rem;"><span style="color:var(--green); font-weight:700;">→</span> Entrepreneur Biographies</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PHILOSOPHY + HUMAN SIDE -->
  <section style="background:#fff; padding:5rem 0;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex flex-col lg:flex-row gap-14 items-start">
        <div class="flex-1 max-w-lg">
          <span class="section-tag mb-3">My Philosophy</span>
          <h2 class="text-3xl lg:text-4xl mb-6" style="color:var(--black);">I don't tell you<br />what you want to hear.</h2>
          <div style="border-left:3px solid var(--red); padding:.75rem 1.25rem; background:rgba(147,31,29,.04); border-radius:0 .5rem .5rem 0; font-style:italic; font-size:1.0625rem; color:var(--black); line-height:1.7; margin-bottom:1.5rem;">
            "I don't just deliver a plan. I stick around to make sure it gets executed. I'm both strategist and practitioner. That combination is rare—and it's exactly what your business needs."
          </div>
          <p style="font-size:1.0625rem; color:#4b5563; line-height:1.75; margin-bottom:1rem;">
            I've been doing this for over 25 years. I know what works and what doesn't. When I work with you, I tell you exactly how things should be done—not what's most comfortable to hear.
          </p>
          <p style="font-size:1.0625rem; color:#4b5563; line-height:1.75;">
            That sometimes makes people uncomfortable. And it's also exactly why my clients keep coming back.
          </p>
        </div>
        <div class="flex-1">
          <span class="section-tag mb-3">Outside of Work</span>
          <h2 class="text-3xl lg:text-4xl mb-6" style="color:var(--black);">The person behind the work</h2>
          <div style="display:flex; flex-direction:column; gap:.875rem;">
            {[
              { title: 'Family first', body: "25 years married to my best friend. My kids live in Canada and I couldn't be prouder—not just as a father, but because that experience made me a better consultant." },
              { title: 'Lifelong discipline', body: "I've been working out since I was 15. That's 35+ years of showing up consistently. The same discipline I apply to my body is the same I bring to every client engagement." },
              { title: 'Compulsive reader', body: '~20 books a year, every year. I listen while I work out or walk. Knowledge doesn\'t expire—but it needs to be updated constantly.' },
              { title: 'Quiet evenings', body: 'Cooking with my wife while we watch Netflix. Those calm nights at home are what recharge me to show up fully the next day.' },
            ].map((trait) => (
              <div style="display:flex; align-items:flex-start; gap:1rem; padding:1.25rem; border-radius:.75rem; background:#fff; border:1px solid #f3f4f6;">
